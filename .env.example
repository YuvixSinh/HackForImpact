# AutoShip environment variables. Copy to .env.local and fill in values locally.
# Never commit real values. Only variables prefixed NEXT_PUBLIC_ reach the browser,
# so server secrets must never use that prefix.
#
# The app runs without any of these, using in-memory repositories.
# They are required for the hosted checks: npm run db:verify and npm run test:integration.

# Demo sign-in session signing key (server-only, at least 32 characters).
# Optional in development (a random per-process key is used; sessions end on restart).
# Required for `npm start` / production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Supabase development project (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
# Public anon / publishable key. Safe for the browser; row-level security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service-role / secret key. Bypasses RLS; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# SolvaPay sandbox (server-only; never prefix with NEXT_PUBLIC_). Leave SOLVAPAY_SECRET_KEY empty
# to use the deterministic testing adapter. When it is set, both references below are required.
# Only sandbox keys (sk_sandbox_…) are accepted; live keys are refused. See README "SolvaPay sandbox".
SOLVAPAY_SECRET_KEY=sk_sandbox_EcIznD/r9+L0O2OFyJ4P/ZrVHbbCszYbofggVJjoQz4=
# Reference of a credit-based SolvaPay product priced at one minor currency unit per usage unit.
SOLVAPAY_PRODUCT_REF=prd_C6KI57U1
# SolvaPay customer reference whose prepaid credit balance pays for the demo shipper's bookings.
SOLVAPAY_CUSTOMER_REF=cus_01UQC19R
# Optional. Defaults to https://api.solvapay.com (sandbox and live share it; the key selects sandbox).
SOLVAPAY_API_BASE_URL=
