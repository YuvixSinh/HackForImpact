# AutoShip environment variables. Copy to .env.local and fill in values locally.
# Never commit real values. Only variables prefixed NEXT_PUBLIC_ reach the browser,
# so server secrets must never use that prefix.
#
# The app runs without any of these, using in-memory repositories.
# They are required for the hosted checks: npm run db:verify and npm run test:integration.

# Supabase development project (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
# Public anon / publishable key. Safe for the browser; row-level security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service-role / secret key. Bypasses RLS; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# SolvaPay (Milestone 3): server-only sandbox secret key, added in a later task.
